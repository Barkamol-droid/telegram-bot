# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAA-your-token-here
# Admin Telegram ID lari (vergul bilan ajrating)
ADMIN_IDS=123456789,987654321
# Do'kon nomi
SHOP_NAME=Azure Jewelry
# Telegram kanal (bo'sh qoldirsangiz, kanal tugmasi chiqmaydi)
CHANNEL=@azure_jewelry
# PostgreSQL (ixtiyoriy). Berilsa, SQLite o'rniga ishlatiladi
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Ma'lumotlar bazasi fayli (SQLite)
DB_PATH=shop.db
# "Aloqa" tugmasi bosilganda chiqadigan matn
CONTACT_TEXT=📞 Telefon: +998 90 000 00 00\n📍 Manzil: Toshkent sh., ...\n🕘 Ish vaqti: 9:00 - 21:00
# Vaqt mintaqasi (aksiya boshlanishi/tugashi shu bo'yicha)
TIMEZONE=Asia/Tashkent
# Tilga xos matnlar (ixtiyoriy): CONTACT_TEXT_RU, CONTACT_TEXT_TG, CONTACT_TEXT_KK, ABOUT_TEXT_RU va h.k.
# CONTACT_TEXT_RU=📞 Телефон: +998 90 000 00 00\n📍 Адрес: г. Ташкент
